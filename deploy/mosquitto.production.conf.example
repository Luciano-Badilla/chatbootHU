# El proceso Laravel se conecta por la red local; no expongas este puerto a Internet.
listener 1883 127.0.0.1
protocol mqtt

# Nginx termina TLS y reenvía /mqtt a este listener local.
listener 9001 127.0.0.1
protocol websockets

allow_anonymous false
persistence true
persistence_location /var/lib/mosquitto/
log_dest file /var/log/mosquitto/mosquitto.log
log_type error
log_type warning
log_type notice

# Requiere credenciales y ACL. Configurar con el plugin Dynamic Security
# antes de activar este archivo.
# plugin /usr/lib/x86_64-linux-gnu/mosquitto_dynamic_security.so
# plugin_opt_config_file /etc/mosquitto/dynamic-security.json
